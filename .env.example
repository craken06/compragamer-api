# Conexión a Postgres (formato Prisma)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/auryx_db"
PORT=3001

# Dominios del frontend permitidos por CORS, separados por coma (sin barra final).
# Vacío = solo se aceptan orígenes locales (desarrollo).
CORS_ORIGINS="https://auryx.com,https://www.auryx.com"

# Cotización del dólar (todas opcionales)
USD_ARS_CASA=oficial          # oficial | bolsa | blue | contadoconliqui | mayorista | tarjeta
# USD_ARS_RATE_OVERRIDE=1500  # fija el valor a mano y pisa la cotización en vivo
# USD_ARS_FALLBACK_RATE=1350  # se usa solo si nunca se pudo consultar la fuente

# --- Login del panel de administración (compragamer-admin) ---
# Toda la administración exige el token de POST /auth/login (no hay clave aparte para scripts).
# JWT_SECRET: clave larga y aleatoria para firmar las sesiones. Si falta, la administración queda deshabilitada.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_USER=admin
# node scripts/hash-password.js  (pide la contraseña; formato scrypt:<sal>:<hash>)
ADMIN_PASSWORD_HASH=

# --- Cuentas de clientes ---
# ID de cliente OAuth de Google (Google Cloud Console > Credenciales); el mismo que usa el sitio.
# Sin esto el ingreso de clientes queda deshabilitado. Las sesiones se firman con JWT_SECRET.
GOOGLE_CLIENT_ID=

# --- Mercado Pago (Checkout Pro) ---
# Sin MP_ACCESS_TOKEN (ni transferencia habilitada) POST /orders responde 503: todo se paga online.
# Para probar usá las credenciales de prueba (TEST-...) del panel de desarrolladores de MP.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Adónde vuelve el cliente después de pagar
FRONTEND_URL=https://craken06.github.io/auryx-frontend
# URL pública de esta API (MP le avisa los pagos a <API_PUBLIC_URL>/payments/webhook)
API_PUBLIC_URL=https://noncerebral-betsey-somniloquous.ngrok-free.dev

# --- Mails (Resend) ---
# Sin RESEND_API_KEY no se envía ningún mail (queda una línea en el log). Ver "Mails" en el README.
RESEND_API_KEY=
MAIL_FROM=AURYX <avisos@auryx.com.ar>
# Avisos internos (contactos, arrepentimientos, pedidos). Vacío = solo se le escribe al cliente.
NOTIFY_EMAIL=contacto@auryx.com.ar

# --- Transferencia bancaria (preparada, deshabilitada por defecto) ---
# Se habilita con TRANSFER_ENABLED=true y TRANSFER_BANK completo (titular y CBU o alias).
TRANSFER_ENABLED=
TRANSFER_BANK={"holder":"","cuit":"","bank":"","cbu":"","alias":""}
TRANSFER_DISCOUNT_PCT=0        # % de descuento pagando por transferencia
TRANSFER_DEADLINE_HOURS=72     # plazo para pagar; sin comprobante, el pedido se cancela solo

# --- Archivos (Cloudflare R2) ---
# Bucket privado: comprobantes, recursos y entregas (descarga con URL firmada).
# Bucket público: portadas (R2_PUBLIC_URL = dominio público del bucket, sin barra final).
# CORS de los dos buckets: PUT y GET desde https://auryx.com.ar, encabezado Content-Type.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# --- Videos de cursos (Bunny Stream) ---
# Library con "Token Authentication" activado y "Allowed domains" = auryx.com.ar.
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_TOKEN_KEY=

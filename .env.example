# Conexión a Postgres (formato Prisma)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/auryx_db"
PORT=3001

# Dominios del frontend permitidos por CORS, separados por coma (sin barra final).
# Vacío = solo se aceptan orígenes locales (desarrollo).
CORS_ORIGINS="https://auryx.com,https://www.auryx.com"

# Cotización del dólar (todas opcionales)
USD_ARS_CASA=oficial          # oficial | bolsa | blue | contadoconliqui | mayorista | tarjeta
# USD_ARS_RATE_OVERRIDE=1500  # fija el valor a mano y pisa la cotización en vivo
# USD_ARS_FALLBACK_RATE=1350  # se usa solo si nunca se pudo consultar la fuente

# --- Login del panel de administración (compragamer-admin) ---
# Toda la administración exige el token de POST /auth/login (no hay clave aparte para scripts).
# JWT_SECRET: clave larga y aleatoria para firmar las sesiones. Si falta, la administración queda deshabilitada.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_USER=admin
# node scripts/hash-password.js  (pide la contraseña; formato scrypt:<sal>:<hash>)
ADMIN_PASSWORD_HASH=

# --- Cuentas de clientes ---
# ID de cliente OAuth de Google (Google Cloud Console > Credenciales); el mismo que usa el sitio.
# Sin esto el ingreso de clientes queda deshabilitado. Las sesiones se firman con JWT_SECRET.
GOOGLE_CLIENT_ID=

# --- Mercado Pago (Checkout Pro) ---
# Sin MP_ACCESS_TOKEN los pedidos se guardan como cotización (sin pago online).
# Para probar usá las credenciales de prueba (TEST-...) del panel de desarrolladores de MP.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Adónde vuelve el cliente después de pagar
FRONTEND_URL=https://craken06.github.io/auryx-frontend
# URL pública de esta API (MP le avisa los pagos a <API_PUBLIC_URL>/payments/webhook)
API_PUBLIC_URL=https://noncerebral-betsey-somniloquous.ngrok-free.dev

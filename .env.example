# Conexión a Postgres (formato Prisma)
DATABASE_URL="postgresql://usuario:clave@localhost:5432/auryx_db"
PORT=3001

# Dominios del frontend permitidos por CORS, separados por coma (sin barra final).
# Vacío = solo se aceptan orígenes locales (desarrollo).
CORS_ORIGINS="https://auryx.com,https://www.auryx.com"

# Clave para POST/PUT/DELETE de productos (header x-admin-key). Si falta, la escritura queda deshabilitada.
# Generá una larga y aleatoria, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# Cotización del dólar (todas opcionales)
USD_ARS_CASA=oficial          # oficial | bolsa | blue | contadoconliqui | mayorista | tarjeta
# USD_ARS_RATE_OVERRIDE=1500  # fija el valor a mano y pisa la cotización en vivo
# USD_ARS_FALLBACK_RATE=1350  # se usa solo si nunca se pudo consultar la fuente

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockStatus {
  disponible
  a_pedido
  sin_stock

  @@map("stock_status_enum")
}

model Category {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  name       String
  specSchema Json?     @map("spec_schema")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  products   Product[]

  @@map("categories")
}

model Product {
  id           Int            @id @default(autoincrement())
  categoryId   Int            @map("category_id")
  category     Category       @relation(fields: [categoryId], references: [id])
  brand        String
  name         String
  sku          String?        @unique
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("ARS")
  stockStatus  StockStatus    @default(disponible) @map("stock_status")
  description  String?
  specs        Json           @default("{}")
  datasheetUrl String?        @map("datasheet_url")
  active       Boolean        @default(true) // false = no se usa en ningún lado (tienda, dimensionador ni pedidos)
  showInStore  Boolean        @default(true) @map("show_in_store") // false = fuera de la tienda; el dimensionador lo sigue usando
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  images       ProductImage[]

  @@map("products")
}

// Reglas del motor de compatibilidad (ver src/compatibility/engine.ts).
// source_category = "_param" guarda parámetros globales (check_key = nombre, condition.value = valor).
model CompatibilityRule {
  id             Int      @id @default(autoincrement())
  sourceCategory String   @map("source_category")
  targetCategory String   @map("target_category")
  checkKey       String   @map("check_key")
  priority       Int      @default(100)
  condition      Json
  resultType     String   @map("result_type") // bad | warning (o "param")
  message        String   @default("")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("compatibility_rules")
}

enum OrderStatus {
  pendiente_pago
  pagado
  rechazado
  cancelado
  cotizacion

  @@map("order_status_enum")
}

enum PaymentMethod {
  mercadopago
  transferencia

  @@map("payment_method_enum")
}

enum FulfillmentStatus {
  pendiente
  preparando
  enviado
  listo_para_retirar
  entregado

  @@map("fulfillment_status_enum")
}

model Customer {
  id             Int                @id @default(autoincrement())
  email          String             @unique
  name           String
  avatarUrl      String?            @map("avatar_url")
  phone          String?
  defaultAddress Json?              @map("default_address")
  billingDoc     String?            @map("billing_doc")
  billingName    String?            @map("billing_name")
  blocked        Boolean            @default(false)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt    DateTime           @default(now()) @map("last_login_at") @db.Timestamptz
  identities     CustomerIdentity[]
  orders         Order[]
  enrollments    Enrollment[]

  @@map("customers")
}

model CustomerIdentity {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   String // google | microsoft
  subject    String
  email      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, subject])
  @@index([customerId])
  @@map("customer_identities")
}

model Order {
  id                Int               @id @default(autoincrement())
  publicId          String            @unique @map("public_id")
  code              String            @unique // AX-XXXXXX
  status            OrderStatus       @default(pendiente_pago)
  customerName      String            @map("customer_name")
  customerEmail     String            @map("customer_email")
  customerPhone     String?           @map("customer_phone")
  notes             String?
  totalArs          Decimal           @map("total_ars") @db.Decimal(14, 2)
  usdArsRate        Decimal           @map("usd_ars_rate") @db.Decimal(12, 4)
  mpPreferenceId    String?           @map("mp_preference_id")
  mpPaymentId       String?           @map("mp_payment_id")
  mpStatus          String?           @map("mp_status")
  customerId        Int?              @map("customer_id")
  customer          Customer?         @relation(fields: [customerId], references: [id])
  deliveryMethod    String?           @map("delivery_method") // envio | retiro
  shippingAddress   Json?             @map("shipping_address")
  billingDoc        String?           @map("billing_doc")
  billingName       String?           @map("billing_name")
  fulfillmentStatus FulfillmentStatus @default(pendiente) @map("fulfillment_status")
  trackingNumber    String?           @map("tracking_number")
  paymentUrl        String?           @map("payment_url")
  paymentMethod     PaymentMethod     @default(mercadopago) @map("payment_method")
  transferDeadline  DateTime?         @map("transfer_deadline") @db.Timestamptz
  receiptKey        String?           @map("receipt_key")
  receiptUploadedAt DateTime?         @map("receipt_uploaded_at") @db.Timestamptz
  paidAt            DateTime?         @map("paid_at") @db.Timestamptz
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  items             OrderItem[]

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int     @map("order_id")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int     @map("product_id")
  productName  String  @map("product_name")
  quantity     Int
  unitPriceArs Decimal @map("unit_price_ars") @db.Decimal(14, 2)

  @@map("order_items")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String? @map("alt_text")
  order     Int     @default(0) @map("order")

  @@map("product_images")
}

// ---------------------------------------------------------------- cursos (Auryx Academia)
// Ver docs/superpowers/specs/2026-10-22-cursos-design.md. Migración: 2026-10-22_cursos.sql

enum CourseStatus {
  borrador
  publicado
  archivado

  @@map("course_status_enum")
}

enum CourseLevel {
  inicial
  intermedio
  avanzado

  @@map("course_level_enum")
}

enum LessonKind {
  video
  lectura
  prueba
  tarea

  @@map("lesson_kind_enum")
}

enum EnrollmentStatus {
  pendiente_pago
  activa
  cancelada

  @@map("enrollment_status_enum")
}

enum SubmissionStatus {
  entregada
  aprobada
  a_rehacer

  @@map("submission_status_enum")
}

model Course {
  id                 Int            @id @default(autoincrement())
  slug               String         @unique
  title              String
  subtitle           String         @default("")
  description        String         @default("")
  coverUrl           String?        @map("cover_url")
  level              CourseLevel    @default(inicial)
  durationHours      Decimal        @default(0) @map("duration_hours") @db.Decimal(6, 1)
  priceArs           Decimal        @default(0) @map("price_ars") @db.Decimal(12, 2) // 0 = gratis
  status             CourseStatus   @default(borrador)
  sequential         Boolean        @default(false) // true = cada lección se abre al completar la anterior
  instructorName     String         @default("") @map("instructor_name")
  instructorBio      String         @default("") @map("instructor_bio")
  instructorPhotoUrl String?        @map("instructor_photo_url")
  outcomes           Json           @default("[]") // lista de textos: qué vas a aprender
  requirements       Json           @default("[]")
  position           Int            @default(0) // orden en el catálogo
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  modules            CourseModule[]
  enrollments        Enrollment[]

  @@map("courses")
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  courseId    Int      @map("course_id")
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  position    Int      @default(0)
  lessons     Lesson[]

  @@index([courseId])
  @@map("course_modules")
}

model Lesson {
  id            Int                    @id @default(autoincrement())
  moduleId      Int                    @map("module_id")
  module        CourseModule           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  kind          LessonKind             @default(video)
  title         String
  body          String                 @default("") // texto con formato simple (ver el sitio: courseTextHTML)
  videoProvider String?                @map("video_provider") // bunny | youtube
  videoId       String?                @map("video_id")
  durationMin   Int                    @default(0) @map("duration_min")
  isPreview     Boolean                @default(false) @map("is_preview") // se ve sin inscripción
  isOptional    Boolean                @default(false) @map("is_optional") // no cuenta para el certificado
  position      Int                    @default(0)
  passPct       Int                    @default(70) @map("pass_pct") // prueba: nota mínima
  maxAttempts   Int?                   @map("max_attempts") // prueba: null = sin límite
  instructions  String                 @default("") // tarea: consigna
  resources     LessonResource[]
  questions     QuizQuestion[]
  progress      LessonProgress[]
  attempts      QuizAttempt[]
  submissions   AssignmentSubmission[]

  @@index([moduleId])
  @@map("lessons")
}

model LessonResource {
  id       Int     @id @default(autoincrement())
  lessonId Int     @map("lesson_id")
  lesson   Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind     String  @default("archivo") // archivo | link
  title    String
  fileKey  String? @map("file_key") // R2 privado
  fileName String? @map("file_name")
  fileSize Int?    @map("file_size")
  url      String?
  position Int     @default(0)

  @@index([lessonId])
  @@map("lesson_resources")
}

model QuizQuestion {
  id          Int    @id @default(autoincrement())
  lessonId    Int    @map("lesson_id")
  lesson      Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind        String @default("unica") // unica | multiple | vf
  prompt      String
  options     Json   @default("[]") // [{ id, text, correct }]: correct nunca sale al alumno
  explanation String @default("")
  position    Int    @default(0)

  @@index([lessonId])
  @@map("quiz_questions")
}

model Enrollment {
  id             Int                    @id @default(autoincrement())
  code           String                 @unique // CU-XXXXXX (external_reference en Mercado Pago)
  courseId       Int                    @map("course_id")
  course         Course                 @relation(fields: [courseId], references: [id])
  customerId     Int                    @map("customer_id")
  customer       Customer               @relation(fields: [customerId], references: [id])
  status         EnrollmentStatus       @default(pendiente_pago)
  priceArs       Decimal                @default(0) @map("price_ars") @db.Decimal(12, 2)
  source         String                 @default("compra") // compra | gratis | manual
  mpPreferenceId String?                @map("mp_preference_id")
  mpPaymentId    String?                @map("mp_payment_id")
  mpStatus       String?                @map("mp_status")
  paymentUrl     String?                @map("payment_url")
  paidAt         DateTime?              @map("paid_at") @db.Timestamptz
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  completedAt    DateTime?              @map("completed_at") @db.Timestamptz
  progress       LessonProgress[]
  attempts       QuizAttempt[]
  submissions    AssignmentSubmission[]
  certificate    Certificate?

  @@unique([courseId, customerId])
  @@index([customerId])
  @@map("enrollments")
}

model LessonProgress {
  enrollmentId Int        @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     Int        @map("lesson_id")
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt  DateTime   @default(now()) @map("completed_at") @db.Timestamptz

  @@id([enrollmentId, lessonId])
  @@map("lesson_progress")
}

model QuizAttempt {
  id           Int        @id @default(autoincrement())
  enrollmentId Int        @map("enrollment_id")
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     Int        @map("lesson_id")
  lesson       Lesson     @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  answers      Json
  scorePct     Int        @map("score_pct")
  passed       Boolean
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([enrollmentId, lessonId])
  @@map("quiz_attempts")
}

model AssignmentSubmission {
  id           Int              @id @default(autoincrement())
  enrollmentId Int              @map("enrollment_id")
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     Int              @map("lesson_id")
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  text         String           @default("")
  fileKey      String?          @map("file_key")
  fileName     String?          @map("file_name")
  fileSize     Int?             @map("file_size")
  status       SubmissionStatus @default(entregada)
  feedback     String           @default("")
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz
  reviewedAt   DateTime?        @map("reviewed_at") @db.Timestamptz

  @@index([enrollmentId, lessonId])
  @@index([status])
  @@map("assignment_submissions")
}

model Certificate {
  id                Int        @id @default(autoincrement())
  code              String     @unique // CERT-XXXXXX
  enrollmentId      Int        @unique @map("enrollment_id")
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  nameOnCertificate String     @map("name_on_certificate")
  courseTitle       String     @map("course_title") // copia: si el curso cambia, el certificado no
  durationHours     Decimal    @map("duration_hours") @db.Decimal(6, 1)
  issuedAt          DateTime   @default(now()) @map("issued_at") @db.Timestamptz
  revokedAt         DateTime?  @map("revoked_at") @db.Timestamptz
  revokeReason      String?    @map("revoke_reason")

  @@map("certificates")
}

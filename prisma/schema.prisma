generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StockStatus {
  disponible
  a_pedido
  sin_stock

  @@map("stock_status_enum")
}

model Category {
  id         Int       @id @default(autoincrement())
  slug       String    @unique
  name       String
  specSchema Json?     @map("spec_schema")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  products   Product[]

  @@map("categories")
}

model Product {
  id           Int            @id @default(autoincrement())
  categoryId   Int            @map("category_id")
  category     Category       @relation(fields: [categoryId], references: [id])
  brand        String
  name         String
  sku          String?        @unique
  price        Decimal        @db.Decimal(12, 2)
  currency     String         @default("ARS")
  stockStatus  StockStatus    @default(disponible) @map("stock_status")
  description  String?
  specs        Json           @default("{}")
  datasheetUrl String?        @map("datasheet_url")
  active       Boolean        @default(true) // false = no se usa en ningún lado (tienda, dimensionador ni pedidos)
  showInStore  Boolean        @default(true) @map("show_in_store") // false = fuera de la tienda; el dimensionador lo sigue usando
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  images       ProductImage[]

  @@map("products")
}

// Reglas del motor de compatibilidad (ver src/compatibility/engine.ts).
// source_category = "_param" guarda parámetros globales (check_key = nombre, condition.value = valor).
model CompatibilityRule {
  id             Int      @id @default(autoincrement())
  sourceCategory String   @map("source_category")
  targetCategory String   @map("target_category")
  checkKey       String   @map("check_key")
  priority       Int      @default(100)
  condition      Json
  resultType     String   @map("result_type") // bad | warning (o "param")
  message        String   @default("")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("compatibility_rules")
}

enum OrderStatus {
  pendiente_pago
  pagado
  rechazado
  cancelado
  cotizacion

  @@map("order_status_enum")
}

enum FulfillmentStatus {
  pendiente
  preparando
  enviado
  listo_para_retirar
  entregado

  @@map("fulfillment_status_enum")
}

model Customer {
  id             Int                @id @default(autoincrement())
  email          String             @unique
  name           String
  avatarUrl      String?            @map("avatar_url")
  phone          String?
  defaultAddress Json?              @map("default_address")
  billingDoc     String?            @map("billing_doc")
  billingName    String?            @map("billing_name")
  blocked        Boolean            @default(false)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  lastLoginAt    DateTime           @default(now()) @map("last_login_at") @db.Timestamptz
  identities     CustomerIdentity[]
  orders         Order[]

  @@map("customers")
}

model CustomerIdentity {
  id         Int      @id @default(autoincrement())
  customerId Int      @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider   String // google | microsoft
  subject    String
  email      String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, subject])
  @@index([customerId])
  @@map("customer_identities")
}

model Order {
  id                Int               @id @default(autoincrement())
  publicId          String            @unique @map("public_id")
  code              String            @unique // AX-XXXXXX
  status            OrderStatus       @default(pendiente_pago)
  customerName      String            @map("customer_name")
  customerEmail     String            @map("customer_email")
  customerPhone     String?           @map("customer_phone")
  notes             String?
  totalArs          Decimal           @map("total_ars") @db.Decimal(14, 2)
  usdArsRate        Decimal           @map("usd_ars_rate") @db.Decimal(12, 4)
  mpPreferenceId    String?           @map("mp_preference_id")
  mpPaymentId       String?           @map("mp_payment_id")
  mpStatus          String?           @map("mp_status")
  customerId        Int?              @map("customer_id")
  customer          Customer?         @relation(fields: [customerId], references: [id])
  deliveryMethod    String?           @map("delivery_method") // envio | retiro
  shippingAddress   Json?             @map("shipping_address")
  billingDoc        String?           @map("billing_doc")
  billingName       String?           @map("billing_name")
  fulfillmentStatus FulfillmentStatus @default(pendiente) @map("fulfillment_status")
  trackingNumber    String?           @map("tracking_number")
  paymentUrl        String?           @map("payment_url")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  items             OrderItem[]

  @@index([customerId])
  @@map("orders")
}

model OrderItem {
  id           Int     @id @default(autoincrement())
  orderId      Int     @map("order_id")
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    Int     @map("product_id")
  productName  String  @map("product_name")
  quantity     Int
  unitPriceArs Decimal @map("unit_price_ars") @db.Decimal(14, 2)

  @@map("order_items")
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int     @map("product_id")
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  altText   String? @map("alt_text")
  order     Int     @default(0) @map("order")

  @@map("product_images")
}
